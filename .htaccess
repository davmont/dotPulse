# Root-level files that must never be requested over HTTP:
# - queuescanner.php runs from cron on the command line (see docs/deployment-security.md)
# - dependency manifests, Markdown documentation and the Makefile
<FilesMatch "^queuescanner\.php$|^(composer\.(json|lock)|package(-lock)?\.json|Makefile)$|\.md$">
	<IfModule mod_authz_core.c>
		Require all denied
	</IfModule>
	<IfModule !mod_authz_core.c>
		Order allow,deny
		Deny from all
	</IfModule>
</FilesMatch>

# The REST API (api.php) reads its token from the Authorization header, which CGI and
# PHP-FPM setups do not pass to PHP unless it is copied into the environment.
<IfModule mod_setenvif.c>
	SetEnvIf Authorization "(.+)" HTTP_AUTHORIZATION=$1
</IfModule>
